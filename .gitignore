.superpowers/
/build/
.python312/
.venv/
.venv-mac/
__pycache__/
.DS_Store
*.pyc
configurator/dist/
configurator/dist-debug/
configurator/nuitka-crash-report.xml
configurator/.venv-build/
*.egg-info/

# Device configurations pulled off a board during acceptance: bench state,
# not source. Restoring one needs the file, not its history.
hardware-backups/

# Scratch trees agents copy out for mutation testing.
.test-tmp/

# HIL baseline readings: the counter values a measure phase subtracts. Bench
# state for one run, regenerated by the next `--phase baseline`.
artifacts/*.state.json
artifacts/

# Release folders assembled by tools/build_release.ps1 from a clean tree.
# The inputs are tracked; the output is reproducible from them.
dist/

# The PIO USB toolchain: Pico SDK, TinyUSB and Pico-PIO-USB clones that
# tools/bootstrap_pio_usb_toolchain.ps1 fetches at pinned revisions. The pin
# lives in cmake/pio_usb_toolchain_lock.cmake; the clones are reproducible
# from it and must never be tracked.
.deps/
