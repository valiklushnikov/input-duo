+// Duo Input: control-transfer packet trace
+//--------------------------------------------------------------------+
+//
+// A software logic analyser for control transfers, so that "the device sent
+// nothing" can be told apart from "the host stack lost what the device sent".
+// Diagnostic and temporary; it is carried as its own patch so it can be
+// deleted by deleting a file.
+//
+// Placement is the whole design. Every call site below is *after* the
+// handshake for the packet it records has already gone out -
+// pio_usb_bus_receive_packet_and_handshake sends the ACK before it returns -
+// so nothing here runs inside the 2..7 bit-time window the USB specification
+// gives a host to answer in. Instrumentation before that ACK has been
+// measured on this hardware to break enumeration outright.
+//
+// The record site copies at most sixteen bytes and a handful of scalars. It
+// does not format, print, allocate, block or wait.
+
+#define PIO_USB_CTRL_TRACE_KIND_SETUP 0u
+#define PIO_USB_CTRL_TRACE_KIND_DATA 1u
+#define PIO_USB_CTRL_TRACE_KIND_DONE 2u
+
+// Power of two: the indices below are masked rather than divided.
+#define PIO_USB_CTRL_TRACE_CAPACITY 512u
+#define PIO_USB_CTRL_TRACE_MASK (PIO_USB_CTRL_TRACE_CAPACITY - 1u)
+#define PIO_USB_CTRL_TRACE_BYTES 16u
+
+typedef struct {
+  uint32_t seq;
+  uint16_t len;
+  uint16_t ep_size;
+  uint16_t actual_len;
+  uint16_t total_len;
+  uint8_t kind;
+  uint8_t dev_addr;
+  uint8_t ep_num;
+  uint8_t pid;
+  uint8_t byte_count;
+  uint8_t bytes[PIO_USB_CTRL_TRACE_BYTES];
+} pio_usb_ctrl_trace_entry_t;
+
+static pio_usb_ctrl_trace_entry_t ctrl_trace_ring[PIO_USB_CTRL_TRACE_CAPACITY];
+// Written by the transaction path, read by the core that drains it.
+static volatile uint32_t ctrl_trace_head = 0;
+static volatile uint32_t ctrl_trace_tail = 0;
+static volatile uint32_t ctrl_trace_lost = 0;
+static volatile uint32_t ctrl_trace_seq = 0;
+
+static void __no_inline_not_in_flash_func(ctrl_trace_record)(
+    uint8_t kind, const endpoint_t *ep, uint8_t pid, uint16_t len,
+    const uint8_t *bytes) {
+  // Control endpoints only. A single keyboard produces thousands of interrupt
+  // IN packets a second, and any of them in this ring buries the enumeration
+  // and the descriptor experiments it exists to capture.
+  if ((ep->ep_num & 0x7f) != 0) {
+    return;
+  }
+
+  // Incremented even when the record is refused, so a gap in the sequence
+  // numbers is itself visible in the trace.
+  uint32_t const seq = ctrl_trace_seq++;
+  uint32_t const head = ctrl_trace_head;
+  uint32_t const tail = ctrl_trace_tail;
+  if (head - tail >= PIO_USB_CTRL_TRACE_CAPACITY) {
+    // Full. Refuse and count: a silently dropped packet leaves a hole that
+    // reads exactly like a packet the device never sent.
+    ctrl_trace_lost++;
+    return;
+  }
+
+  pio_usb_ctrl_trace_entry_t *entry =
+      &ctrl_trace_ring[head & PIO_USB_CTRL_TRACE_MASK];
+  entry->seq = seq;
+  entry->kind = kind;
+  entry->dev_addr = ep->dev_addr;
+  entry->ep_num = ep->ep_num;
+  entry->pid = pid;
+  entry->len = len;
+  entry->ep_size = ep->size;
+  entry->actual_len = ep->actual_len;
+  entry->total_len = ep->total_len;
+
+  uint16_t copied = (len < PIO_USB_CTRL_TRACE_BYTES) ? len
+                                                     : PIO_USB_CTRL_TRACE_BYTES;
+  if (bytes == NULL) {
+    copied = 0;
+  }
+  for (uint16_t idx = 0; idx < copied; idx++) {
+    entry->bytes[idx] = bytes[idx];
+  }
+  entry->byte_count = (uint8_t)copied;
+
+  // The entry's bytes have to be visible before the index that advertises
+  // them; the consumer runs on the other core.
+  __dmb();
+  ctrl_trace_head = head + 1;
+}
+
+// Drained in ordinary task context, from the core that prints. Scalars only:
+// the entry layout stays private to this file, so nothing outside it has to
+// mirror a struct it cannot include. out_bytes must have room for
+// PIO_USB_CTRL_TRACE_BYTES.
+bool pio_usb_host_ctrl_trace_take(uint32_t *out_seq, uint8_t *out_kind,
+                                  uint8_t *out_dev_addr, uint8_t *out_ep_num,
+                                  uint8_t *out_pid, uint16_t *out_len,
+                                  uint16_t *out_ep_size,
+                                  uint16_t *out_actual_len,
+                                  uint16_t *out_total_len, uint8_t *out_bytes,
+                                  uint8_t *out_byte_count) {
+  uint32_t const tail = ctrl_trace_tail;
+  if (ctrl_trace_head == tail) {
+    return false;
+  }
+  __dmb();
+
+  pio_usb_ctrl_trace_entry_t const *entry =
+      &ctrl_trace_ring[tail & PIO_USB_CTRL_TRACE_MASK];
+  *out_seq = entry->seq;
+  *out_kind = entry->kind;
+  *out_dev_addr = entry->dev_addr;
+  *out_ep_num = entry->ep_num;
+  *out_pid = entry->pid;
+  *out_len = entry->len;
+  *out_ep_size = entry->ep_size;
+  *out_actual_len = entry->actual_len;
+  *out_total_len = entry->total_len;
+  for (uint8_t idx = 0; idx < PIO_USB_CTRL_TRACE_BYTES; idx++) {
+    out_bytes[idx] = entry->bytes[idx];
+  }
+  *out_byte_count = entry->byte_count;
+
+  __dmb();
+  ctrl_trace_tail = tail + 1;
+  return true;
+}
+
+uint32_t pio_usb_host_ctrl_trace_lost(void) { return ctrl_trace_lost; }
